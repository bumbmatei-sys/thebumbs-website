{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thebumbs-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "previews": {
    "d1_databases": [
      {
        "binding": "NEWSLETTER_DB",
        "database_name": "thebumbs-newsletter-preview",
        "database_id": "f6e9eed9-f741-487a-9db1-6696ff40d3dc"
      }
    ]
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "NEWSLETTER_DB",
      "database_name": "thebumbs-newsletter",
      "database_id": "e8233d1c-058b-4c1e-b9bc-30416a87b13d"
    }
  ]
}
